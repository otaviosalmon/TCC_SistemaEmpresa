@model TCC_SistemaEmpresa.Models.ViewModels.FuncionarioFormViewModel
@{
    var titulo = Model.SomenteLeitura
        ? "Funcionário"
        : Model.EhEdicao ? "Editar Funcionário" : "Criar Funcionário";

    var acao = Model.EhEdicao ? "Edit" : "Create";
    var desabilitado = Model.SomenteLeitura ? "disabled" : null;
}

<h1 class="form-titulo">@titulo</h1>

<form method="post" asp-action="@acao" asp-route-id="@(Model.EhEdicao ? Model.Id.ToString() : null)">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alerta alerta-erro"></div>

    <div class="form-grid">
        <div class="campo campo-nome">
            <label asp-for="Nome">Nome Funcionário:</label>
            <input asp-for="Nome" placeholder="Nome..." maxlength="150" autocomplete="off" disabled="@desabilitado" />
            <span asp-validation-for="Nome" class="campo-erro"></span>
        </div>

        <div class="campo campo-id">
            <span class="campo-rotulo">Id:</span>
            @if (Model.EhEdicao)
            {
                <span class="campo-valor">@Model.Id</span>
            }
            else if (Model.ProximoId.HasValue)
            {
                <span class="campo-valor campo-valor-previsto"
                      title="Número previsto. O id definitivo é atribuído pelo banco ao salvar e pode ser maior se outro cadastro for gravado antes.">
                    @Model.ProximoId
                </span>
            }
            else
            {
                <span class="campo-valor campo-valor-previsto">Gerado automaticamente</span>
            }
        </div>

        <div class="campo campo-cpf">
            <label asp-for="Cpf">CPF</label>
            <input asp-for="Cpf" placeholder="Insira o CPF..." maxlength="14"
                   inputmode="numeric" autocomplete="off" disabled="@desabilitado" />
            <span asp-validation-for="Cpf" class="campo-erro"></span>
        </div>

        <div class="campo campo-ativo">
            <label asp-for="Ativo">Ativo:</label>
            <select asp-for="Ativo" disabled="@desabilitado">
                <option value="True">Ativo</option>
                <option value="False">Inativo</option>
            </select>
            <span asp-validation-for="Ativo" class="campo-erro"></span>
        </div>

        <div class="campo campo-salario">
            <label asp-for="Salario">Salário:</label>
            <input asp-for="Salario" placeholder="R$00,00" inputmode="decimal"
                   data-val-number="Informe um valor numérico." disabled="@desabilitado" />
            <span asp-validation-for="Salario" class="campo-erro"></span>
        </div>

        <div class="campo campo-comissao">
            <label asp-for="PerComissao">Comissão:</label>
            <input asp-for="PerComissao" placeholder="0%" inputmode="decimal"
                   data-val-number="Informe um valor numérico." disabled="@desabilitado" />
            <span asp-validation-for="PerComissao" class="campo-erro"></span>
        </div>

        <div class="campo campo-data">
            <label asp-for="DataAdmissao">Data de Admissão:</label>
            <input asp-for="DataAdmissao" type="date" disabled="@desabilitado" />
            <span asp-validation-for="DataAdmissao" class="campo-erro"></span>
        </div>

        <div class="campo campo-cargo">
            <label asp-for="CargoId">Selecione Cargo:</label>
            <select asp-for="CargoId" asp-items="Model.Cargos" disabled="@desabilitado">
                <option value="0">Selecione o Cargo...</option>
            </select>
            <span asp-validation-for="CargoId" class="campo-erro"></span>
        </div>
    </div>

    <div class="form-acoes">
        @if (Model.SomenteLeitura)
        {
            <a class="btn btn-escuro" asp-action="Index">Voltar</a>
        }
        else
        {
            <button type="submit" class="btn btn-claro">Salvar</button>
            <a class="btn btn-escuro" asp-action="Index">Cancelar</a>
        }
    </div>
</form>
