@model TCC_SistemaEmpresa.Models.ViewModels.FuncionarioListaViewModel
@{
    ViewData["Title"] = "Funcionários";
}

<div class="pagina-titulo-centro">
    <h1 class="pagina-titulo">Funcionários</h1>
</div>

@if (TempData["Sucesso"] is string mensagemSucesso)
{
    <div class="alerta alerta-sucesso">@mensagemSucesso</div>
}

@* Recusa vinda do servidor — acontece quando o POST não passou pelo popup. *@
@if (TempData["Erro"] is string mensagemErro)
{
    <div class="alerta alerta-erro">@mensagemErro</div>
}

<form method="get" asp-action="Index" class="listagem-barra">
    <div class="busca">
        <input type="text" name="busca" value="@Model.Busca" placeholder="Pesquisar..."
               aria-label="Pesquisar por nome ou CPF" />
        <button type="submit" aria-label="Pesquisar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35" />
            </svg>
        </button>
    </div>

    <div class="filtro">
        <select name="situacao" onchange="this.form.submit()" aria-label="Filtrar por situação">
            <option value="todos" selected="@(Model.Situacao == "todos")">Filtros...</option>
            <option value="ativos" selected="@(Model.Situacao == "ativos")">Somente ativos</option>
            <option value="inativos" selected="@(Model.Situacao == "inativos")">Somente inativos</option>
        </select>
    </div>
</form>

<div class="tabela-wrapper">
    <table class="tabela">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Nome</th>
                <th scope="col">Cargo</th>
                <th scope="col">Salario</th>
                <th scope="col">Ativo</th>
                <th scope="col" aria-label="Ações"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Funcionarios.Count == 0)
            {
                <tr class="tabela-vazia">
                    <td colspan="6">Nenhum funcionário encontrado.</td>
                </tr>
            }
            else
            {
                @foreach (var funcionario in Model.Funcionarios)
                {
                    <tr>
                        <td>@funcionario.Id</td>
                        <td>@funcionario.Nome</td>
                        <td>@funcionario.Cargo</td>
                        @* Cultura pt-BR fixada em Program.cs: "C" já sai como R$ 10.510,00. *@
                        <td>@(funcionario.Salario?.ToString("C") ?? "—")</td>
                        <td>
                            @if (funcionario.Ativo)
                            {
                                <span class="marcador-ativo sim" title="Ativo" role="img" aria-label="Ativo">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 6L9 17l-5-5" />
                                    </svg>
                                </span>
                            }
                            else
                            {
                                <span class="marcador-ativo" title="Inativo" role="img" aria-label="Inativo"></span>
                            }
                        </td>
                        <td class="col-acoes">
                            <div class="acoes-linha">
                                <a class="acao-icone" asp-action="Details" asp-route-id="@funcionario.Id"
                                   title="Visualizar" aria-label="Visualizar @funcionario.Nome">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" />
                                    </svg>
                                </a>

                                <a class="acao-icone" asp-action="Edit" asp-route-id="@funcionario.Id"
                                   title="Editar" aria-label="Editar @funcionario.Nome">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </a>

                                @* O X é sempre exclusão — nunca inativação. Três estados:
                                     ativo               -> desabilitado (inative pela edição)
                                     inativo com vendas  -> popup explicando o bloqueio
                                     inativo sem vendas  -> exclui de vez, com confirmação
                                   O POST fica num formulário à parte porque quem dispara
                                   o submit é o popup, não o clique no ícone. *@
                                @if (funcionario.Ativo)
                                {
                                    <button type="button" class="acao-icone" disabled
                                            aria-label="Excluir @funcionario.Nome"
                                            title="Funcionário ativo não pode ser excluído. Inative pela tela de edição.">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 6L6 18M6 6l12 12" />
                                        </svg>
                                    </button>
                                }
                                else if (funcionario.QuantidadeVendas > 0)
                                {
                                    <button type="button" class="acao-icone perigo"
                                            title="Não pode ser excluído" aria-label="Excluir @funcionario.Nome"
                                            data-modal-titulo="Exclusão não permitida"
                                            data-modal-texto="@funcionario.Nome possui @funcionario.QuantidadeVendas venda(s) registrada(s) e não pode ser excluído. Excluir o cadastro deixaria essas vendas sem responsável. O funcionário permanece inativo.">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 6L6 18M6 6l12 12" />
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <form method="post" asp-action="Excluir" asp-route-id="@funcionario.Id"
                                          id="acao-@funcionario.Id" class="acao-form">
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <button type="button" class="acao-icone perigo"
                                            title="Excluir" aria-label="Excluir @funcionario.Nome"
                                            data-modal-titulo="Excluir funcionário"
                                            data-modal-texto="Excluir definitivamente o cadastro de @funcionario.Nome? O registro sai do banco e esta ação não pode ser desfeita."
                                            data-modal-confirmar="Excluir"
                                            data-modal-form="acao-@funcionario.Id">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 6L6 18M6 6l12 12" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="listagem-rodape">
    <a class="btn btn-claro" asp-action="Create">+ Novo</a>
</div>

@* Um único popup para a tela toda: o gatilho clicado preenche título, texto e
   qual formulário confirmar. Ver wwwroot/js/modal.js. *@
<dialog class="modal" data-modal aria-labelledby="modalTitulo">
    <h2 class="modal-titulo" id="modalTitulo" data-modal-titulo-alvo></h2>
    <p class="modal-texto" data-modal-texto-alvo></p>
    <div class="modal-acoes">
        <button type="button" class="btn btn-escuro" data-modal-fechar>Fechar</button>
        <button type="button" class="btn btn-perigo" data-modal-confirmar-alvo hidden></button>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/modal.js" asp-append-version="true"></script>
}
