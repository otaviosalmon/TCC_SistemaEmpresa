@model TCC_SistemaEmpresa.Models.ViewModels.CargoFormViewModel
@{
    var titulo = Model.SomenteLeitura
        ? "Cargo"
        : Model.EhEdicao ? "Editar Cargo" : "Criar Cargo";

    var acao = Model.EhEdicao ? "Edit" : "Create";
    var desabilitado = Model.SomenteLeitura ? "disabled" : null;
}

<h1 class="form-titulo">@titulo</h1>

<form method="post" asp-action="@acao" asp-route-id="@(Model.EhEdicao ? Model.Id.ToString() : null)">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alerta alerta-erro"></div>

    <div class="form-grid">
        <div class="campo campo-cargo-nome">
            <label asp-for="Nome">Nome:</label>
            <input asp-for="Nome" placeholder="Nome do cargo..." maxlength="100" autocomplete="off" disabled="@desabilitado" />
            <span asp-validation-for="Nome" class="campo-erro"></span>
        </div>

        <div class="campo campo-cargo-id">
            <span class="campo-rotulo">Id:</span>
            @if (Model.EhEdicao)
            {
                <span class="campo-valor">@Model.Id</span>
            }
            else if (Model.ProximoId.HasValue)
            {
                <span class="campo-valor campo-valor-previsto"
                      title="Número previsto. O id definitivo é atribuído pelo banco ao salvar e pode ser maior se outro cadastro for gravado antes.">
                    @Model.ProximoId
                </span>
            }
            else
            {
                <span class="campo-valor campo-valor-previsto">Gerado automaticamente</span>
            }
        </div>

        <div class="campo campo-salario">
            <label asp-for="SalarioBase">Salário Base:</label>
            <input asp-for="SalarioBase" placeholder="R$00,00" inputmode="decimal"
                   data-val-number="Informe um valor numérico." disabled="@desabilitado" />
            <span asp-validation-for="SalarioBase" class="campo-erro"></span>
            @if (!Model.SomenteLeitura)
            {
                <span class="campo-ajuda">
                    Valores padrão do cargo. Se o funcionário tiver salário ou comissão próprios, os dele prevalecem.
                </span>
            }
        </div>

        <div class="campo campo-comissao">
            <label asp-for="PerComissaoBase">Comissão:</label>
            <input asp-for="PerComissaoBase" placeholder="0%" inputmode="decimal"
                   data-val-number="Informe um valor numérico." disabled="@desabilitado" />
            <span asp-validation-for="PerComissaoBase" class="campo-erro"></span>
        </div>

        <div class="campo campo-ativo">
            <label asp-for="Ativo">Ativo:</label>
            <select asp-for="Ativo" disabled="@desabilitado">
                <option value="True">Ativo</option>
                <option value="False">Inativo</option>
            </select>
            <span asp-validation-for="Ativo" class="campo-erro"></span>
        </div>

        @if (Model.EhEdicao && Model.QuantidadeFuncionarios > 0)
        {
            <div class="campo campo-cargo-vinculos">
                <span class="campo-rotulo">Funcionários:</span>
                <span class="campo-valor">
                    @Model.QuantidadeFuncionarios registro(s), @Model.QuantidadeFuncionariosAtivos ativo(s)
                </span>
                <span class="campo-ajuda">
                    Com funcionário ativo o cargo não pode ser inativado. Com qualquer funcionário vinculado, não pode ser excluído.
                </span>
            </div>
        }

        <div class="campo campo-largo">
            <label asp-for="Descricao">Descrição:</label>
            <textarea asp-for="Descricao" placeholder="Descrição..." maxlength="255"
                      rows="7" disabled="@desabilitado"></textarea>
            <span asp-validation-for="Descricao" class="campo-erro"></span>
        </div>
    </div>

    <div class="form-acoes">
        @if (Model.SomenteLeitura)
        {
            <a class="btn btn-escuro" asp-action="Index">Voltar</a>
        }
        else
        {
            <button type="submit" class="btn btn-claro">Salvar</button>
            <a class="btn btn-escuro" asp-action="Index">Cancelar</a>
        }
    </div>
</form>