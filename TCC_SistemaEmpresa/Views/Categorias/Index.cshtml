@model TCC_SistemaEmpresa.Models.ViewModels.CategoriaProdutoListaViewModel
@{
    ViewData["Title"] = "Tipos de Produto";
}

<div class="pagina-titulo-centro">
    <h1 class="pagina-titulo">Tipo Produto</h1>
</div>

@if (TempData["Sucesso"] is string mensagemSucesso)
{
    <div class="alerta alerta-sucesso">@mensagemSucesso</div>
}

@if (TempData["Erro"] is string mensagemErro)
{
    <div class="alerta alerta-erro">@mensagemErro</div>
}

<form method="get" asp-action="Index" class="listagem-barra">
    <div class="busca">
        <input type="text" name="busca" value="@Model.Busca" placeholder="Pesquisar..."
               aria-label="Pesquisar por nome do tipo de produto" />
        <button type="submit" aria-label="Pesquisar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35" />
            </svg>
        </button>
    </div>
</form>

<div class="tabela-wrapper">
    <table class="tabela">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Nome</th>
                <th scope="col">Produtos</th>
                <th scope="col" aria-label="Ações"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Categorias.Count == 0)
            {
                <tr class="tabela-vazia">
                    <td colspan="4">Nenhum tipo de produto encontrado.</td>
                </tr>
            }
            else
            {
                @foreach (var categoria in Model.Categorias)
                {
                    <tr>
                        <td>@categoria.Id</td>
                        <td>@categoria.Nome</td>
                        <td>@categoria.QuantidadeProdutos</td>
                        <td class="col-acoes">
                            <div class="acoes-linha">
                                <a class="acao-icone" asp-action="Details" asp-route-id="@categoria.Id"
                                   title="Visualizar" aria-label="Visualizar @categoria.Nome">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" /><circle cx="12" cy="12" r="3" />
                                    </svg>
                                </a>

                                <a class="acao-icone" asp-action="Edit" asp-route-id="@categoria.Id"
                                   title="Editar" aria-label="Editar @categoria.Nome">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </a>

                                @if (!categoria.PodeExcluir)
                                {
                                    <button type="button" class="acao-icone perigo"
                                            title="Não pode ser excluído" aria-label="Excluir @categoria.Nome"
                                            data-modal-titulo="Exclusão não permitida"
                                            data-modal-texto="@categoria.Nome classifica @categoria.QuantidadeProdutos produto(s) e não pode ser excluído. Excluir o cadastro deixaria esses produtos sem tipo.">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 6L6 18M6 6l12 12" />
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <form method="post" asp-action="Excluir" asp-route-id="@categoria.Id"
                                          id="acao-@categoria.Id" class="acao-form">
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <button type="button" class="acao-icone perigo"
                                            title="Excluir" aria-label="Excluir @categoria.Nome"
                                            data-modal-titulo="Excluir tipo de produto"
                                            data-modal-texto="Excluir definitivamente o cadastro de @categoria.Nome? O registro sai do banco e esta ação não pode ser desfeita."
                                            data-modal-confirmar="Excluir"
                                            data-modal-form="acao-@categoria.Id">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18 6L6 18M6 6l12 12" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="listagem-rodape">
    <a class="btn btn-claro" asp-action="Create">+ Novo</a>
</div>

<dialog class="modal" data-modal aria-labelledby="modalTitulo">
    <h2 class="modal-titulo" id="modalTitulo" data-modal-titulo-alvo></h2>
    <p class="modal-texto" data-modal-texto-alvo></p>
    <div class="modal-acoes">
        <button type="button" class="btn btn-escuro" data-modal-fechar>Fechar</button>
        <button type="button" class="btn btn-perigo" data-modal-confirmar-alvo hidden></button>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/modal.js" asp-append-version="true"></script>
}
