@using System.Security.Claims
@using TCC_SistemaEmpresa.Security
@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;


    var nomeEmpresa = User.FindFirst(ClaimsEmpresa.EmpresaNome)?.Value ?? "Nome Empresa";
    var nomeUsuario = User.Identity?.Name ?? string.Empty;
    var emailUsuario = User.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
    var iniciais = string.IsNullOrEmpty(nomeUsuario) ? "?" : nomeUsuario[..1].ToUpperInvariant();


    var controllersPorGrupo = new Dictionary<string, string[]>
    {
        ["gerenciamento"] = new[] { "Produtos", "Categorias", "CategoriasDespesa", "TiposMovimentacao", "FormasPagamento", "Clientes", "Funcionarios", "Usuarios" },
        ["financeiro"] = new[] { "Vendas", "Movimentacoes", "Despesas" },
        ["relatorios"] = new[] { "Relatorios", "Previsao" }
    };

    var grupoAberto = controllersPorGrupo
        .FirstOrDefault(grupo => grupo.Value.Contains(controllerAtual, StringComparer.OrdinalIgnoreCase))
        .Key;


    const string grupoExclusivo = "sidebar-grupo";

    var categoriasAberto = new[] { "Categorias", "CategoriasDespesa", "TiposMovimentacao", "FormasPagamento" }
        .Contains(controllerAtual, StringComparer.OrdinalIgnoreCase);
}

<aside class="sidebar">
    <div class="sidebar-marca" title="@nomeEmpresa">@nomeEmpresa</div>

    <nav class="sidebar-nav">
        <a class="sidebar-item @(controllerAtual == "Home" ? "ativo" : null)"
           asp-controller="Home" asp-action="Index">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path d="M3 9h18M9 21V9" />
            </svg>
            DashBoard
        </a>

        <details class="sidebar-grupo" name="@grupoExclusivo" open="@(grupoAberto == "gerenciamento" ? "open" : null)">
            <summary class="sidebar-grupo-titulo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
                </svg>
                Gerenciamento
                <svg class="chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            </summary>
            <div class="sidebar-subitens">
                <a class="sidebar-item @(controllerAtual == "Produtos" ? "ativo" : null)"
                   asp-controller="Produtos" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l9 5v10l-9 5-9-5V7z" />
                        <path d="M3 7l9 5 9-5M12 12v10" />
                    </svg>
                    Produtos
                </a>
                <details class="sidebar-grupo" open="@(categoriasAberto ? "open" : null)">
                    <summary class="sidebar-grupo-titulo">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1" />
                            <rect x="14" y="3" width="7" height="7" rx="1" />
                            <rect x="3" y="14" width="7" height="7" rx="1" />
                            <rect x="14" y="14" width="7" height="7" rx="1" />
                        </svg>
                        Categorias
                        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 18l6-6-6-6" />
                        </svg>
                    </summary>
                    <div class="sidebar-subitens">
                        <a class="sidebar-item @(controllerAtual == "Categorias" ? "ativo" : null)"
                           asp-controller="Categorias" asp-action="Index">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2l9 5v10l-9 5-9-5V7z" />
                                <path d="M3 7l9 5 9-5" />
                            </svg>
                            Tipo Produto
                        </a>
                        <a class="sidebar-item @(controllerAtual == "CategoriasDespesa" ? "ativo" : null)"
                           asp-controller="CategoriasDespesa" asp-action="Index">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M11 3v18" />
                                <path d="M15.5 6.5H8.75a2.75 2.75 0 0 0 0 5.5h4.5a2.75 2.75 0 0 1 0 5.5H6" />
                            </svg>
                            Categoria Despesa
                        </a>
                        <a class="sidebar-item @(controllerAtual == "TiposMovimentacao" ? "ativo" : null)"
                           asp-controller="TiposMovimentacao" asp-action="Index">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 4v13M7 4L4 7.5M7 4l3 3.5" />
                                <path d="M17 20V7M17 20l3-3.5M17 20l-3-3.5" />
                            </svg>
                            Tipo Movimentação
                        </a>
                        <a class="sidebar-item @(controllerAtual == "FormasPagamento" ? "ativo" : null)"
                           asp-controller="FormasPagamento" asp-action="Index">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" />
                            </svg>
                            Forma Pagamento
                        </a>
                    </div>
                </details>
                <a class="sidebar-item @(controllerAtual == "Clientes" ? "ativo" : null)"
                   asp-controller="Clientes" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3.5" />
                        <path d="M2 20v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1" />
                        <path d="M17 8h5M19.5 5.5v5" />
                    </svg>
                    Clientes
                </a>
                <a class="sidebar-item @(controllerAtual == "Funcionarios" ? "ativo" : null)"
                   asp-controller="Funcionarios" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3.5" />
                        <path d="M2 20v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1" />
                        <path d="M17 20v-1a5 5 0 0 0-3-4.58M15.5 4.6a3.5 3.5 0 0 1 0 6.8" />
                    </svg>
                    Funcionários
                </a>
                <span class="sidebar-item indisponivel" title="Módulo ainda não implementado">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="3.5" />
                        <path d="M5 20v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1" />
                    </svg>
                    Usuários
                </span>
            </div>
        </details>

        <details class="sidebar-grupo" name="@grupoExclusivo" open="@(grupoAberto == "financeiro" ? "open" : null)">
            <summary class="sidebar-grupo-titulo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
                Financeiro
                <svg class="chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            </summary>
            <div class="sidebar-subitens">
                <a class="sidebar-item @(controllerAtual == "Vendas" ? "ativo" : null)"
                   asp-controller="Vendas" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="3" />
                        <path d="M12 7v7M8.5 10.5L12 14l3.5-3.5" />
                    </svg>
                    Vendas
                </a>
                <a class="sidebar-item @(controllerAtual == "Movimentacoes" ? "ativo" : null)"
                   asp-controller="Movimentacoes" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 4v13M7 4L4 7.5M7 4l3 3.5" />
                        <path d="M17 20V7M17 20l3-3.5M17 20l-3-3.5" />
                    </svg>
                    Movimentações
                </a>
                <a class="sidebar-item @(controllerAtual == "Despesas" ? "ativo" : null)"
                   asp-controller="Despesas" asp-action="Index">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 3v18" />
                        <path d="M15.5 6.5H8.75a2.75 2.75 0 0 0 0 5.5h4.5a2.75 2.75 0 0 1 0 5.5H6" />
                        <path d="M17 15h5" />
                    </svg>
                    Despesas
                </a>
            </div>
        </details>

        <details class="sidebar-grupo" name="@grupoExclusivo" open="@(grupoAberto == "relatorios" ? "open" : null)">
            <summary class="sidebar-grupo-titulo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <path d="M14 2v6h6M8 13h8M8 17h8" />
                </svg>
                Relatórios
                <svg class="chevron" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            </summary>
            <div class="sidebar-subitens">
                <span class="sidebar-item indisponivel" title="Módulo ainda não implementado">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h9" />
                        <path d="M13 2v6h6" />
                        <circle cx="16" cy="16" r="3.2" />
                        <path d="M18.4 18.4L21 21" />
                    </svg>
                    Relatórios Detalhados
                </span>
                <span class="sidebar-item indisponivel" title="Módulo ainda não implementado">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6" />
                        <path d="M8 17l2.5-3 2 2L16 12" />
                    </svg>
                    Previsão/IA
                </span>
            </div>
        </details>
    </nav>

    <div class="sidebar-rodape">
        <span class="sidebar-item indisponivel" title="Módulo ainda não implementado">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            Configurações
        </span>

        <div class="sidebar-usuario">
            <span class="sidebar-usuario-avatar">@iniciais</span>
            <div class="sidebar-usuario-dados">
                <div class="sidebar-usuario-nome" title="@nomeUsuario">@nomeUsuario</div>
                <div class="sidebar-usuario-email" title="@emailUsuario">@emailUsuario</div>
            </div>
            <form method="post" asp-controller="Account" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-logout" title="Sair" aria-label="Sair">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                    </svg>
                </button>
            </form>
        </div>
    </div>
</aside>
