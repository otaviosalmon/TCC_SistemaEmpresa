@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TCC_SistemaEmpresa</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page" id="loginPage" data-view="login">
        <div class="login-card view-login">
            <h1>Bem vindo!</h1>
            <p class="subtitle">Faça o login para começar</p>

            <form class="login-form">
                <input type="text" name="usuario" placeholder="Usuário" autocomplete="username" />

                <div class="password-field">
                    <input type="password" name="senha" id="senha" placeholder="Senha" autocomplete="current-password" />
                    <button type="button" class="toggle-password" id="toggleSenha" aria-label="Mostrar senha" aria-pressed="false">
                        <svg class="icon-eye" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="icon-eye-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a20.3 20.3 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 7 11 7a20.3 20.3 0 0 1-4.22 5.06" />
                            <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                            <line x1="1" y1="1" x2="23" y2="23" />
                        </svg>
                    </button>
                </div>

                <a href="#" class="forgot-link" id="forgotLink">Esqueci minha Senha</a>

                <button type="submit" class="login-button">Login</button>
            </form>
        </div>

        <div class="login-card view-forgot">
            <p class="forgot-message">Para trocar sua senha<br />contate seu administrador</p>
            <button type="button" class="login-button forgot-button" id="voltarBtn">Voltar</button>
        </div>
    </div>

    <script>
        const toggleBtn = document.getElementById('toggleSenha');
        const senhaInput = document.getElementById('senha');

        toggleBtn.addEventListener('click', function () {
            const willShow = senhaInput.type === 'password';
            senhaInput.type = willShow ? 'text' : 'password';
            toggleBtn.setAttribute('aria-pressed', String(willShow));
            toggleBtn.setAttribute('aria-label', willShow ? 'Ocultar senha' : 'Mostrar senha');
        });

        const loginPage = document.getElementById('loginPage');
        const forgotLink = document.getElementById('forgotLink');
        const voltarBtn = document.getElementById('voltarBtn');

        forgotLink.addEventListener('click', function (e) {
            e.preventDefault();
            loginPage.setAttribute('data-view', 'forgot');
        });

        voltarBtn.addEventListener('click', function () {
            loginPage.setAttribute('data-view', 'login');
        });
    </script>
</body>
</html>
